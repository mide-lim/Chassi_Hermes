# Exemplo público para edição manual.
# Destino: %UserProfile%\.wslconfig, no Windows.
# Preserve as opções existentes e use a seção [wsl2] já existente, se houver.
# Não substitua o arquivo inteiro automaticamente por este exemplo.
# Configure antes de criar a distribuição e recarregue a configuração do WSL.
# O valor define o máximo padrão para novos discos; não reduz discos existentes.
# Fonte: https://learn.microsoft.com/en-us/windows/wsl/wsl-config

[wsl2]
defaultVhdSize=512GB
